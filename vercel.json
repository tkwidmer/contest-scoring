    { "source": "/pricing", "destination": "/api/page?path=/pricing" },
    { "source": "/features", "destination": "/api/page?path=/features" },
    { "source": "/r/:id", "destination": "/api/page?path=/r/:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
